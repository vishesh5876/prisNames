# ============================================
# PrisNames — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# Do NOT commit .env files with real credentials.
# ============================================

# --- Application ---
NODE_ENV=development
PORT=4000
WORKER_PORT=4001

# --- URLs ---
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Site Branding ---
# In production, ALL of these must be explicitly configured.
# The development defaults below must never reach production.
SITE_NAME=Domains
SITE_DESCRIPTION=Domain Registration & Management
SITE_URL=http://localhost:3000
SUPPORT_EMAIL=support@localhost
SITE_OPERATOR=Pristine Internet Services

# --- PostgreSQL ---
DATABASE_URL=postgresql://prisnames:prisnames@147.79.67.235:5432/prisnames

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me-in-production-use-32-byte-random
COOKIE_DOMAIN=localhost
SESSION_MAX_AGE_SECONDS=604800

# --- Dynadot ---
DYNADOT_ENVIRONMENT=sandbox
DYNADOT_API_KEY=sandbox_7h647r8B8q6v7K7N8NF70X9A8I7M6C6G6U6v8u6JO6T7X6T7p6L8M6CNoJ7i6j
DYNADOT_API_SECRET=sandbox_c6a1f3988b674e979422e73ddc928eb364de94f6146ed83066685f291a20a340
DYNADOT_WEBHOOK_KEY=
DYNADOT_WEBHOOK_SECRET=
DYNADOT_ACCOUNT_TIER=REGULAR

# --- Encryption ---
ENCRYPTION_KEY=change-me-in-production-use-32-byte-hex

# Queue encryption (BullMQ auth email payload encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUEUE_ENCRYPTION_KEY=3efca9cdf99cf0dfb614094af77ed0417baf377d58269a031ce59a4248d9f0e6
QUEUE_ENCRYPTION_KEY_ID=k-auth-001

# --- Email ---
EMAIL_PROVIDER=mailpit
EMAIL_FROM=noreply@prisnames.com
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Payment (future) ---
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=

# --- Observability ---
LOG_LEVEL=debug
LOG_FORMAT=pretty
# SENTRY_DSN=
AUTH_OTP_PEPPER=dev-otp-pepper-for-local-testing-only-32chars

# Test database (used for auth integration and migration baseline verification)
TEST_DATABASE_URL=postgresql://prisnames:prisnames@147.79.67.235:5432/prisnames
