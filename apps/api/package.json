{
  "name": "@prisnames/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@prisnames/config": "workspace:*",
    "@prisnames/contracts": "workspace:*",
    "@prisnames/database": "workspace:*",
    "@prisnames/email-core": "workspace:*",
    "@prisnames/logger": "workspace:*",
    "@prisnames/registrar-core": "workspace:*",
    "@prisnames/registrar-dynadot": "workspace:*",
    "@prisnames/security": "workspace:*",
    "bullmq": "^5.81.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.4",
    "ioredis": "^5.6.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "postgres": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
