{
  "name": "@prisnames/registrar-dynadot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:sandbox": "DYNADOT_SANDBOX_ENABLED=true vitest run --passWithNoTests src/__tests__/sandbox.integration.test.ts",
    "test:redis": "vitest run --passWithNoTests src/__tests__/rate-limiter.integration.test.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@prisnames/registrar-core": "workspace:*",
    "@prisnames/config": "workspace:*",
    "@prisnames/logger": "workspace:*",
    "@prisnames/security": "workspace:*",
    "ioredis": "^5.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "ioredis-mock": "^8.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
